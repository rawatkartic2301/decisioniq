# Environment & Logging
DECISIONIQ_ENV=development
DECISIONIQ_LOG_LEVEL=INFO

# Vector Store & Retrieval Configuration
# Supported stores: faiss, chroma
DECISIONIQ_VECTOR_STORE=faiss
# Supported strategies: dense, bm25, hybrid, hybrid_rerank
DECISIONIQ_RETRIEVAL_STRATEGY=hybrid_rerank
DECISIONIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DECISIONIQ_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DECISIONIQ_TOP_K=5
DECISIONIQ_RERANK_TOP_K=3

# LLM Provider Configuration
# Supported providers: mock, openai, anthropic, ollama
DECISIONIQ_LLM_PROVIDER=mock
DECISIONIQ_LLM_MODEL=gpt-4o-mini
DECISIONIQ_LLM_TEMPERATURE=0.0

# API Keys (leave empty to use mock/local providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database & Storage
DECISIONIQ_DATABASE_URL=sqlite:///data/db/decisioniq.db
DECISIONIQ_FAISS_INDEX_PATH=data/vectorstores/faiss
DECISIONIQ_CHROMA_PERSIST_DIR=data/vectorstores/chroma

# Security & Guardrails
DECISIONIQ_API_KEY=decisioniq_dev_api_key_12345
DECISIONIQ_RATE_LIMIT_PER_MINUTE=60
DECISIONIQ_SQL_QUERY_TIMEOUT_SECONDS=5
DECISIONIQ_SQL_MAX_LIMIT=100

# Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=decisioniq

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=decisioniq-eval
